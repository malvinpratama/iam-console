# OIDC provider = the IAM gateway. Switch backend (Go ↔ Rust) by changing this.
IAM_ISSUER=https://iam-go.digitalglobalgrowth.com
IAM_CLIENT_ID=iam-admin-console
IAM_CLIENT_SECRET=console-demo-secret-rotate-me
# Auth.js (v5)
AUTH_SECRET=run: openssl rand -base64 32
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true
